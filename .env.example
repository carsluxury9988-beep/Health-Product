# Public origin used for canonical URLs, hreflang, Open Graph and the sitemap. Defaults to https://lebihyakin.my.
NEXT_PUBLIC_SITE_URL=https://lebihyakin.my

# Optional IDs. Scripts are loaded only after explicit analytics consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Optional: Google Search Console HTML-tag token (the domain is already verified by DNS).
NEXT_PUBLIC_GSC_VERIFICATION=
